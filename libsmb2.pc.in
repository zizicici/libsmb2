# libsmb2 pkg-config file

prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: libsmb2
Description: libsmb2 is a client library for accessing SMB shares over a network.
Version: @VERSION@
Requires:
Requires.private: @SMB2_PC_REQUIRES@
Conflicts:
Libs: -L${libdir} -lsmb2
Libs.private: @SMB2_PC_LIBDIRS@ @MAYBE_LIBKRB5@ @SMB2_PC_QUIC_LIBS@ @MAYBE_LIBRDMACM@ @SMB2_PC_CRYPTO_LIBS@ @LIBSOCKET@
Cflags: -I${includedir}
